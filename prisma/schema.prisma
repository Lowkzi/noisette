datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  MEMBER
}

enum CategoryKind {
  EXPENSE
  INCOME
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  DIRECT_DEBIT
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  OTHER
}

enum AccountOwnership {
  INDIVIDUAL
  JOINT
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members        User[]
  accounts       Account[]
  categories     Category[]
  transactions   Transaction[]
  budgets        Budget[]
  savingsGoals   SavingsGoal[]
  recurringBills RecurringBill[]
  invites        HouseholdInvite[]
  oneOffPurchases OneOffPurchase[]
}

model User {
  id       String @id @default(cuid())
  name     String?
  email    String @unique
  password String // Haché (bcrypt)
  role     Role   @default(MEMBER)

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transactionsCreated Transaction[]     @relation("TransactionCreatedBy")
  transactionSplits    TransactionSplit[]
  invitesSent          HouseholdInvite[] @relation("InvitedBy")
  jointAccounts        Account[]        @relation("AccountMembers")
}

model HouseholdInvite {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  email       String
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model Account {
  id             String      @id @default(cuid())
  householdId    String
  household      Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType      @default(CHECKING)
  ownership      AccountOwnership @default(INDIVIDUAL)
  currentBalance Float            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  transfersReceived Transaction[] @relation("TransferDestination")
  recurringBills RecurringBill[]
  budgets Budget[]
  // Membres affiliés, uniquement pertinent pour les comptes joints (ownership = JOINT).
  members User[] @relation("AccountMembers")
}

model Category {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  kind        CategoryKind @default(EXPENSE)
  color       String?
  icon        String?

  createdAt DateTime @default(now())

  transactions   Transaction[]
  budgets        Budget[]
  recurringBills RecurringBill[]
}

model Transaction {
  id          String          @id @default(cuid())
  householdId String
  household   Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)

  accountId   String
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Uniquement pour type = TRANSFER : compte de destination du virement (accountId reste le
  // compte débité). Le solde de toAccount est crédité du même montant.
  toAccountId String?
  toAccount   Account?        @relation("TransferDestination", fields: [toAccountId], references: [id])

  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id])

  amount      Float           // Toujours positif ; le signe est donné par `type`
  date        DateTime
  label       String
  note        String?
  type        TransactionType @default(EXPENSE)

  // Dépense partagée entre membres du foyer : si isShared, les parts sont détaillées
  // dans `splits` (montant dû par chaque membre). V1 simple : pas de règles de répartition
  // complexes, juste un montant par membre.
  isShared Boolean            @default(false)
  splits   TransactionSplit[]

  createdById String
  createdBy   User     @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Part d'une dépense partagée due par un membre du foyer donné.
model TransactionSplit {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareAmount   Float

  @@unique([transactionId, userId])
}

// Budget mensuel par catégorie ET par compte (un objectif n'a de sens que rapporté à un compte
// précis, sinon les dépenses de plusieurs comptes s'agrègent sans distinction). Le montant dépensé
// est calculé à la volée à partir des Transaction du mois plutôt que dénormalisé ici.
model Budget {
  id             String   @id @default(cuid())
  householdId    String
  household      Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  month          DateTime // Toujours le 1er du mois concerné
  plannedAmount  Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weeks BudgetWeek[]

  @@unique([categoryId, accountId, month])
}

// Répartition indicative de l'objectif mensuel par semaine calendaire (0 = semaine 1, ... 4 = semaine 5).
model BudgetWeek {
  id            String @id @default(cuid())
  budgetId      String
  budget        Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  weekIndex     Int
  plannedAmount Float

  @@unique([budgetId, weekIndex])
}

model SavingsGoal {
  id            String    @id @default(cuid())
  householdId   String
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  targetDate    DateTime?
  // Versement mensuel prévu vers cet objectif, pour projeter un montant annuel (mensuel × 12).
  monthlyContribution Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecurringBill {
  id           String    @id @default(cuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  label        String
  amount       Float
  // Dépense récurrente (facture, abonnement) ou revenu récurrent (salaire, primes).
  kind         CategoryKind @default(EXPENSE)
  dueDayOfMonth Int      // 1-31
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  accountId    String?
  account      Account?  @relation(fields: [accountId], references: [id])
  isActive     Boolean   @default(true)
  // Nombre de jours avant l'échéance pour afficher un rappel sur le tableau de bord.
  reminderDaysBefore Int @default(3)
  // Date du dernier prélèvement confirmé (bouton "Marquer comme payée"), pour éviter
  // un double décompte du même mois et savoir si l'échéance en cours est déjà réglée.
  lastPaidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Dépense ponctuelle hors cycle mensuel récurrent (ex. cadeaux de Noël, achat exceptionnel),
// regroupée librement par "occasion" (ex. "Cadeaux Noël") pour lister un budget dédié.
model OneOffPurchase {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  label       String
  amount      Float
  occasion    String?
  isBought    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
